{
  "name": "kuuchil-btz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "validate:content": "node scripts/validate-content.ts",
    "check:dist": "node scripts/check-dist.ts",
    "smoke:dist": "node scripts/smoke-dist.ts",
    "gate": "pnpm lint && pnpm typecheck && pnpm test && pnpm validate:content && pnpm build && pnpm check:dist && pnpm smoke:dist"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
